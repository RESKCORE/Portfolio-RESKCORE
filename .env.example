# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# WEB3FORMS_ACCESS_KEY: Free access key for the contact form to deliver messages directly to your email.
# Get your free key instantly in 10 seconds at https://web3forms.com by entering your email (reddysantosh1310@gmail.com).
VITE_WEB3FORMS_ACCESS_KEY="YOUR_WEB3FORMS_ACCESS_KEY"
